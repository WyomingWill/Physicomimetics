<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fluxo_spinner_bg" />
            <stroke android:width="1.5dp" android:color="@color/fluxo_accent_cyan" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item
        android:width="12dp"
        android:height="8dp"
        android:gravity="end|center_vertical"
        android:end="16dp"
        android:drawable="@drawable/fluxo_dropdown_arrow" />
</layer-list>
