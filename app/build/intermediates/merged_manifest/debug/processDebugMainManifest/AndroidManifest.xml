<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.combinedsimulations"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <permission
        android:name="com.example.combinedsimulations.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.combinedsimulations.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_launcher"
        android:label="Physicomimetics"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme" >
        <activity
            android:name="com.example.combinedsimulations.MainMenuActivity"
            android:exported="true"
            android:screenOrientation="sensorPortrait" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.combinedsimulations.particle.ParticleFormationActivity"
            android:exported="false"
            android:label="Particle Formation"
            android:screenOrientation="fullSensor" />
        <activity
            android:name="com.example.combinedsimulations.newtonian.NewtonianFormationActivity"
            android:exported="false"
            android:label="Split Newtonian Formation"
            android:screenOrientation="fullSensor" />
        <activity
            android:name="com.example.combinedsimulations.coverage.UniformCoverageActivity"
            android:exported="false"
            android:label="Uniform Coverage"
            android:screenOrientation="fullSensor" />
        <activity
            android:name="com.example.combinedsimulations.kinetic.KineticTheoryActivity"
            android:exported="false"
            android:label="Kinetic Theory"
            android:screenOrientation="fullSensor" />
        <activity
            android:name="com.example.combinedsimulations.dinos.DinosActivity"
            android:exported="false"
            android:label="Bioluminescence"
            android:screenOrientation="fullSensor" />
        <activity
            android:name="com.example.combinedsimulations.apo.ApoActivity"
            android:exported="false"
            android:label="Artificial Physics Optimization"
            android:screenOrientation="fullSensor" />
        <activity
            android:name="com.example.combinedsimulations.perfect.PerfectFormationActivity"
            android:exported="false"
            android:label="Perfect Lattice Formation"
            android:screenOrientation="fullSensor" />
        <activity
            android:name="com.example.combinedsimulations.fluxotaxis.FluxotaxisActivity"
            android:exported="false"
            android:label="Fluxotaxis"
            android:screenOrientation="fullSensor" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.combinedsimulations.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>