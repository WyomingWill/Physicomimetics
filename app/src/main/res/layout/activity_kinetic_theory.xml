<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#212121">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2C2C2C"
        app:tabTextColor="#AAAAAA"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabIndicatorColor="#4CAF50">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kinetic Theory" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Info" />

    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/interfaceContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.example.combinedsimulations.kinetic.KineticSimulationView
                android:id="@+id/simulationView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2" />

            <com.example.combinedsimulations.kinetic.VelocityHistogramView
                android:id="@+id/histogramView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp" />

            <ScrollView
                android:id="@+id/controlsScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:fillViewport="true"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button android:id="@+id/btnSetup" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Setup Agents" android:layout_marginEnd="4dp" />
                        <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Move Agents" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
                        <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Stop" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
                        <Button android:id="@+id/btnResample" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Resample" android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <TextView android:id="@+id/labelParticles" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Number of Particles: 1000" android:textColor="#FFFFFF" android:layout_marginTop="16dp" />
                    <com.google.android.material.slider.Slider android:id="@+id/sliderParticles"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:valueFrom="1" android:valueTo="1000" android:value="1000" android:stepSize="1" />

                    <TextView android:id="@+id/labelWallVelocity" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Wall Velocity: 1.0" android:textColor="#FFFFFF" android:layout_marginTop="8dp" />
                    <com.google.android.material.slider.Slider android:id="@+id/sliderWallVelocity"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:valueFrom="0" android:valueTo="2" android:value="1" android:stepSize="0.1" />

                    <TextView android:id="@+id/labelTemperature" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Temperature: 0.010" android:textColor="#FFFFFF" android:layout_marginTop="8dp" />
                    <com.google.android.material.slider.Slider android:id="@+id/sliderTemperature"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:valueFrom="0.001" android:valueTo="0.04" android:value="0.01" android:stepSize="0.001" />

                    <TextView android:id="@+id/labelDelay" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Speed (Delay ms): 16" android:textColor="#FFFFFF" android:layout_marginTop="8dp" />
                    <com.google.android.material.slider.Slider android:id="@+id/sliderDelay"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:valueFrom="0" android:valueTo="200" android:value="16" android:stepSize="1" />

                </LinearLayout>
            </ScrollView>

        </LinearLayout>

        <ScrollView
            android:id="@+id/infoContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#212121"
            android:padding="16dp">

            <TextView
                android:id="@+id/infoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

        </ScrollView>

    </FrameLayout>

</LinearLayout>
